menu "WeMos R32 application"

    config APP_DEVICE_NAME
        string "Device name"
        default "WeMosR32"
        help
            Human-readable device name returned by the status API.

    config APP_WIFI_AP_SSID
        string "SoftAP SSID"
        default "StockMonitor"
        help
            SSID broadcast by the device.

    config APP_WIFI_AP_PASSWORD
        string "SoftAP password"
        default "wemosr32"
        help
            WPA2 password for the SoftAP. Use at least 8 characters.
            An empty value creates an open network.

    config APP_WIFI_AP_CHANNEL
        int "SoftAP channel"
        range 1 13
        default 1

    config APP_WIFI_STA_ENABLED
        bool "Enable station mode"
        default n
        help
            Keep the device connected to an existing Wi-Fi network.
            SoftAP remains enabled so local configuration is always available.

    config APP_WIFI_STA_SSID
        string "Station SSID"
        default ""
        depends on APP_WIFI_STA_ENABLED

    config APP_WIFI_STA_PASSWORD
        string "Station password"
        default ""
        depends on APP_WIFI_STA_ENABLED
        help
            Leave empty for an open network.

    config APP_HTTP_SERVER_ENABLED
        bool "Enable HTTP status API"
        default y
        help
            Starts a small HTTP server on both the SoftAP and station interfaces.

    config APP_BOARD_ENABLED
        bool "Enable OLED, keys, buzzer, motor and indicators"
        default y
        help
            Starts the stock display, four-key input and local feedback
            services. The HTTP configuration page remains available when
            this option is disabled.

    config APP_OLED_I2C_PORT
        int "OLED I2C port"
        range 0 1
        default 0
        depends on APP_BOARD_ENABLED

    config APP_OLED_I2C_SDA_GPIO
        int "OLED I2C SDA GPIO"
        range 0 39
        default 21
        depends on APP_BOARD_ENABLED

    config APP_OLED_I2C_SCL_GPIO
        int "OLED I2C SCL GPIO"
        range 0 39
        default 22
        depends on APP_BOARD_ENABLED

    config APP_OLED_I2C_FREQ_HZ
        int "OLED I2C clock frequency"
        range 100000 400000
        default 100000
        depends on APP_BOARD_ENABLED

    choice APP_OLED_CONTROLLER
        prompt "1.3-inch OLED controller"
        default APP_OLED_CONTROLLER_SH1106
        depends on APP_BOARD_ENABLED
        help
            Most 1.3-inch 128x64 I2C OLED modules use SH1106. Choose SSD1306
            when the module explicitly identifies an SSD1306 controller.

        config APP_OLED_CONTROLLER_SH1106
            bool "SH1106 (132x64 RAM)"

        config APP_OLED_CONTROLLER_SSD1306
            bool "SSD1306 (128x64 RAM)"
    endchoice

    config APP_BUTTON_K1_GPIO
        int "K1 GPIO"
        range 0 39
        default 27
        depends on APP_BOARD_ENABLED

    config APP_BUTTON_K2_GPIO
        int "K2 GPIO"
        range 0 39
        default 16
        depends on APP_BOARD_ENABLED

    config APP_BUTTON_K3_GPIO
        int "K3 GPIO"
        range 0 39
        default 17
        depends on APP_BOARD_ENABLED

    config APP_BUTTON_K4_GPIO
        int "K4 GPIO"
        range 0 39
        default 14
        depends on APP_BOARD_ENABLED

    config APP_BUZZER_ENABLED
        bool "Enable active buzzer feedback"
        default y
        depends on APP_BOARD_ENABLED
        help
            Drives the active-high buzzer service for key confirmation and
            stock refresh feedback.

    config APP_BUZZER_GPIO
        int "Active buzzer GPIO"
        range 0 39
        default 25
        depends on APP_BUZZER_ENABLED

    config APP_VIBRATION_ENABLED
        bool "Enable vibration motor feedback"
        default y
        depends on APP_BOARD_ENABLED
        help
            Drives the vibration service through a three-wire motor module
            with an active-high IN input. Do not connect a bare two-wire
            motor directly to an ESP32 GPIO; use a transistor or MOSFET
            driver with a flyback diode.

    config APP_VIBRATION_GPIO
        int "Vibration motor IN GPIO"
        range 0 39
        default 26
        depends on APP_VIBRATION_ENABLED
        help
            GPIO connected to the motor module IN input. GPIO26 is used by
            default and is independent from the buzzer on GPIO25.

    config APP_STATUS_LED_ENABLED
        bool "Enable board status LED"
        default y
        depends on APP_BOARD_ENABLED
        help
            Drives the onboard user LED independently from the external RGB
            indicator. The ESPDUINO-32 HW707 schematic connects IO2 through
            the blue LED and a 1 kOhm resistor to ground.

    config APP_STATUS_LED_GPIO
        int "Board status LED GPIO"
        range 0 39
        default 2
        depends on APP_STATUS_LED_ENABLED
        help
            GPIO2 is the onboard blue user LED on the ESPDUINO-32 HW707.
            The red power LED is hard-wired to 3.3 V and is not controlled by
            firmware.

    config APP_STATUS_LED_ACTIVE_HIGH
        bool "Board status LED is active high"
        default y
        depends on APP_STATUS_LED_ENABLED
        help
            The HW707 user LED is connected from IO2 through a resistor to
            ground, so a high GPIO level turns it on. Disable this option for
            boards whose user LED is connected to 3.3 V and sinks current.

    config APP_RGB_LED_ENABLED
        bool "Enable RGB indicator LED"
        default y
        depends on APP_BOARD_ENABLED
        help
            Drives a common-cathode RGB LED through three LEDC PWM channels.
            The R, G and B inputs are active-high. Use series resistors when
            the LED module does not already provide current limiting.

    config APP_RGB_LED_RED_GPIO
        int "RGB red GPIO"
        range 0 39
        default 32
        depends on APP_RGB_LED_ENABLED

    config APP_RGB_LED_GREEN_GPIO
        int "RGB green GPIO"
        range 0 39
        default 33
        depends on APP_RGB_LED_ENABLED

    config APP_RGB_LED_BLUE_GPIO
        int "RGB blue GPIO"
        range 0 39
        default 18
        depends on APP_RGB_LED_ENABLED

endmenu
