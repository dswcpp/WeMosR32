CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_APP_OLED_I2C_PORT=0
CONFIG_APP_OLED_I2C_SDA_GPIO=21
CONFIG_APP_OLED_I2C_SCL_GPIO=22
CONFIG_APP_OLED_I2C_FREQ_HZ=100000
CONFIG_APP_OLED_CONTROLLER_SH1106=y
# CONFIG_APP_OLED_CONTROLLER_SSD1306 is not set
CONFIG_APP_BUTTON_K1_GPIO=27
CONFIG_APP_BUTTON_K2_GPIO=16
CONFIG_APP_BUTTON_K3_GPIO=17
CONFIG_APP_BUTTON_K4_GPIO=14
CONFIG_APP_BUZZER_ENABLED=y
CONFIG_APP_BUZZER_GPIO=25
CONFIG_APP_VIBRATION_ENABLED=y
CONFIG_APP_VIBRATION_GPIO=26
CONFIG_APP_STATUS_LED_ENABLED=y
CONFIG_APP_STATUS_LED_GPIO=2
CONFIG_APP_STATUS_LED_ACTIVE_HIGH=y
CONFIG_APP_RGB_LED_ENABLED=y
CONFIG_APP_RGB_LED_RED_GPIO=32
CONFIG_APP_RGB_LED_GREEN_GPIO=33
CONFIG_APP_RGB_LED_BLUE_GPIO=18

