CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_APP_VIBRATION_ENABLED=y
CONFIG_APP_VIBRATION_GPIO=26
CONFIG_APP_RGB_LED_ENABLED=y
CONFIG_APP_RGB_LED_RED_GPIO=4
CONFIG_APP_RGB_LED_GREEN_GPIO=19
CONFIG_APP_RGB_LED_BLUE_GPIO=18
CONFIG_APP_OLED_CONTROLLER_SH1106=y
CONFIG_APP_BUTTONS_ENABLED=y
CONFIG_APP_BUTTON_ACK_GPIO=32
CONFIG_APP_BUTTON_WATER_GPIO=33
CONFIG_APP_BUTTON_MUTE_GPIO=34
CONFIG_APP_BUTTON_PAGE_GPIO=35
CONFIG_APP_BUTTON_DEBOUNCE_MS=25
CONFIG_APP_BUTTON_LONG_PRESS_MS=1500
CONFIG_APP_WORKSTATION_LIGHT_ENABLED=y
CONFIG_APP_WORKSTATION_LIGHT_POWER_GPIO=13
CONFIG_APP_WORKSTATION_LIGHT_BRIGHTNESS_GPIO=14
CONFIG_APP_WORKSTATION_LIGHT_COLOR_GPIO=23
CONFIG_APP_WORKSTATION_LIGHT_RELAY_ACTIVE_LOW=y
CONFIG_APP_WORKSTATION_LIGHT_PULSE_MS=180
CONFIG_APP_WORKSTATION_LIGHT_SETTLE_MS=160
CONFIG_APP_WORKSTATION_LIGHT_PRESENCE_AUTO=y
CONFIG_APP_WORKSTATION_LIGHT_PRESENCE_LED_ENABLED=y
CONFIG_APP_WORKSTATION_LIGHT_PRESENCE_LED_GPIO=2

